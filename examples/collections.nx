@cap("memory.alloc")
fn greet(name: str = "NX") -> str:
    return f"Xin chao {name}!"

@cap("memory.alloc")
def main() -> i32:
    values: List[i32] = List[i32]([3, 1, 2])
    values.append(4)
    values.sort()
    last = values.pop()
    positive = [x * 2 for x in values if x > 0]
    middle = positive[1:3]
    for item in middle:
        print(f"item={item}")

    labels: Dict[str, i32] = {"one": 1, "two": 2}
    labels["three"] = 3
    unique: Set[i32] = {1, 2, 3}
    unique.add(last)
    pair: Tuple[i32, str] = (labels["one"], "one")
    maybe: Optional[i32] = None
    print(greet(name="Nexir"), pair[1], value_or(maybe, 0))
    print("two" in labels, 4 in unique)
    return 0
