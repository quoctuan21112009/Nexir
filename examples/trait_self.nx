trait Combine:
    def combine(self, other: Self) -> i32:
        pass


class Box:
    value: i32

    def combine(self, other: Box) -> i32:
        return self.value + other.value


def sum_two[T: Combine](first: T, second: T) -> i32:
    return first.combine(second)


def main() -> i32:
    print(sum_two(Box(2), Box(3)))
    return 0
