trait AddFive:
    def combine(self, other: i32) -> i32:
        pass


class Box:
    value: i32

    def combine(self, other: i32) -> i32:
        return self.value + other


def apply[T: AddFive](item: T) -> i32:
    return item.combine(5)


def main() -> i32:
    print(apply(Box(7)))
    return 0
