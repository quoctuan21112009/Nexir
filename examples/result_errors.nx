fn checked_div(value: i32) -> i32 raises:
    if value == 0:
        raise "division by zero"
    return 10 / value


fn main() -> i32:
    try:
        answer = checked_div(2)
        print(answer)
    except:
        print("first call failed")
    try:
        answer = checked_div(0)
        print(answer)
    except:
        print("second call failed")
    return 0
