import cpp.chrono

def add(a: i64, b: i64) -> i64:
    res: i64 = 0
    for i in range(1, 100_000_000):  # Tăng lên 100 triệu vòng để dễ thấy thời gian chạy
        res += a + b + i
    return res

a: i64 = int(input("Nhập a: "))
b: i64 = int(input("Nhập b: "))

# Bắt đầu bấm giờ bằng std::chrono của C++
start = chrono.high_resolution_clock.now()
kq: i64 = add(a, b)
end = chrono.high_resolution_clock.now()

# Tính thời gian chạy (ms)
duration_ms = chrono.duration_cast_ms(end - start).count()

print("Kết quả:", kq)
print("Thời gian chạy (C++ chrono):", duration_ms, "ms")
