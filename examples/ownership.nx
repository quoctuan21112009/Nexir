class Counter:
    value: i32

    def __del__(self):
        print("Counter released")


def read(value: borrowed[Counter]) -> i32:
    return value.value


def increment(value: mut[Counter]) -> void:
    value.value += 1


@cap("memory.alloc")
def main() -> i32:
    item: owned[Counter] = owned(Counter(10))
    print(read(item))
    increment(item)
    moved: owned[Counter] = move(item)
    print(read(moved))
    return 0
