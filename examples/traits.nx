trait HasValue:
    def value(self) -> i32:
        pass


class NumberBox:
    number: i32

    def value(self) -> i32:
        return self.number


def twice[T: HasValue](item: T) -> i32:
    return item.value() + item.value()


def main() -> i32:
    box = NumberBox(21)
    print(twice(box))
    return 0
