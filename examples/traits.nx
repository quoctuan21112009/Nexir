trait HasValue:
    fn value(self) -> i32:
        pass


struct NumberBox:
    number: i32

    fn value(self) -> i32:
        return self.number


fn twice[T: HasValue](item: T) -> i32:
    return item.value() + item.value()


fn main() -> i32:
    box = NumberBox(21)
    print(twice(box))
    return 0
