{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Nexir: Run active file",
      "type": "process",
      "command": "nx",
      "args": ["run", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": false },
      "presentation": { "reveal": "always", "focus": false, "panel": "dedicated", "clear": false },
      "problemMatcher": []
    }
  ]
}
